{
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|seo/ssr-blog-meta) exit 1 ;; *) exit 0 ;; esac",
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/recipes/:id", "destination": "/api/recipe?id=:id" },
    { "source": "/products/account", "destination": "/index.html" },
    { "source": "/products/profile", "destination": "/index.html" },
    { "source": "/products/orders", "destination": "/index.html" },
    { "source": "/products/:id", "destination": "/api/product?id=:id" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/blog.js": { "includeFiles": "dist/index.html" },
    "api/recipe.js": { "includeFiles": "dist/index.html" },
    "api/product.js": { "includeFiles": "dist/index.html" }
  }
}
