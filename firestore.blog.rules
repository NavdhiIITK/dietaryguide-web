rules_version = '2';

// Deploy this to the "dietaryguideblog" Firebase project (NOT the same
// project as firestore.rules, which belongs to "dietaryguidewebstore").
// Blog admin auth (blogAuth) lives in this same project, so request.auth
// here reflects a signed-in blog admin — there is no public sign-up flow
// wired to this project, so any authenticated user is treated as an admin.

service cloud.firestore {
  match /databases/{database}/documents {

    // Blog posts — document id is the post's URL slug.
    // Public visitors can only read published posts; admins can read/write everything.
    match /blogs/{slug} {
      allow read: if resource.data.published == true || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
